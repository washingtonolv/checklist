# ============================================================
# CHECKLIST OPERACIONAL D&D - variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA comite .env.local nem chaves reais.
# ============================================================

# ------------------------------------------------------------
# MODO DE EXECUÇÃO
# ------------------------------------------------------------
# Esta branch exige Supabase configurado e não possui fallback local.
# Para Workers, usar .dev.vars.example e os bindings de wrangler.jsonc.
# Publicação definitiva: consulte docs/CLOUDFLARE_PUBLICATION.md.
# ------------------------------------------------------------

# ------------------------------------------------------------
# SUPABASE (ambiente de teste separado)
# Painel: Project Settings > API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço: usada SOMENTE no servidor para criar usuários
# e executar rotinas administrativas. NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# R2: preencher apenas com recursos de teste isolados, nunca na Vercel.
PHOTO_ENV=cloudflare-preview
PREVIEW_SUPABASE_URL=
# Publicação Cloudflare: PHOTO_ENV=cloudflare e destino explicitamente autorizado.
SUPABASE_ALLOWED_URL=
# Credenciais abaixo somente para testes Node/S3.
# Workers usa PHOTOS_BUCKET por binding, sem chaves S3.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PHOTO_RETENTION_CRON_SECRET=

# ------------------------------------------------------------
# APLICAÇÃO
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Checklist Operacional D&D

# Limites de fotos (em MB)
NEXT_PUBLIC_MAX_PHOTO_MB=10
NEXT_PUBLIC_MAX_PHOTOS_PER_TASK=5

# Preservar o arquivo original além da versão otimizada (true/false)
NEXT_PUBLIC_PRESERVE_ORIGINALS=false

# ------------------------------------------------------------
# ROTINA AUTOMÁTICA DE GERAÇÃO DE TAREFAS
# Usar segredo exclusivo no agendador Cloudflare de teste.
# Não alterar a Vercel.
# Gere uma string longa e aleatória, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------
CRON_SECRET=
